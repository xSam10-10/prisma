{
  "sobre": "Ranking base do 'Top 10 canais agora' (Início). Ordem = popularidade no Brasil (TV aberta e por assinatura). n = nome exibido; m = expressão comparada com o nome do canal da lista sem acentos, em minúsculas e sem HD/FHD/4K/[H265]; c = tipo. No aparelho, canais com jogo, filme ou grande programa passando agora, favoritos e vistos por último sobem na lista. Pode editar no GitHub: os aparelhos recebem na próxima atualização dos tops (algumas horas).",
  "canais": [
    { "n": "Globo", "m": "^(tv |rede )?globo(?! ?news)( [a-z ]+)?$", "c": "Aberta" },
    { "n": "SBT", "m": "^sbt( [a-z ]+)?$", "c": "Aberta" },
    { "n": "Record", "m": "^(rede )?record( tv)?(?! news)( [a-z ]+)?$", "c": "Aberta" },
    { "n": "SporTV", "m": "^sportv( ?[0-9])?$", "c": "Esportes" },
    { "n": "GloboNews", "m": "^globo ?news$", "c": "Notícias" },
    { "n": "Band", "m": "^(rede )?band(?! ?news| ?sports)( [a-z]+)?$", "c": "Aberta" },
    { "n": "Premiere", "m": "^premiere( ?(clubes|fc|[0-9]+))?$", "c": "Esportes" },
    { "n": "ESPN", "m": "^espn( ?[0-9])?( brasil)?$", "c": "Esportes" },
    { "n": "Discovery Kids", "m": "^discovery kids$", "c": "Infantil" },
    { "n": "Viva", "m": "^(canal )?viva$", "c": "Novelas" },
    { "n": "Megapix", "m": "^megapix$", "c": "Filmes" },
    { "n": "TNT", "m": "^tnt$", "c": "Filmes" },
    { "n": "Telecine", "m": "^telecine( premium| action| touch| pipoca| cult| fun)?$", "c": "Filmes" },
    { "n": "HBO", "m": "^hbo( ?[0-9]| family| plus| signature| mundi| pop| xtreme)?$", "c": "Filmes e séries" },
    { "n": "Cartoon Network", "m": "^cartoon( network)?$", "c": "Infantil" },
    { "n": "Gloob", "m": "^gloob$", "c": "Infantil" },
    { "n": "Multishow", "m": "^multishow$", "c": "Variedades" },
    { "n": "CNN Brasil", "m": "^cnn brasil$", "c": "Notícias" },
    { "n": "Warner", "m": "^warner( channel| tv)?$", "c": "Séries" },
    { "n": "Universal TV", "m": "^universal( tv| channel)?$", "c": "Séries" },
    { "n": "Space", "m": "^space$", "c": "Filmes" },
    { "n": "Combate", "m": "^combate$", "c": "Esportes" },
    { "n": "Discovery Channel", "m": "^discovery( channel)?$", "c": "Documentários" },
    { "n": "History", "m": "^history( channel)?$", "c": "Documentários" },
    { "n": "GNT", "m": "^gnt$", "c": "Variedades" },
    { "n": "Record News", "m": "^record news$", "c": "Notícias" },
    { "n": "RedeTV!", "m": "^rede ?tv$", "c": "Aberta" },
    { "n": "TV Cultura", "m": "^(tv )?cultura$", "c": "Aberta" },
    { "n": "AXN", "m": "^axn$", "c": "Séries" },
    { "n": "Sony", "m": "^sony( channel)?$", "c": "Séries" },
    { "n": "National Geographic", "m": "^(nat ?geo|national geographic)$", "c": "Documentários" },
    { "n": "Disney Channel", "m": "^disney( channel)?$", "c": "Infantil" },
    { "n": "Nickelodeon", "m": "^nick(elodeon)?$", "c": "Infantil" },
    { "n": "Canal Brasil", "m": "^canal brasil$", "c": "Filmes" },
    { "n": "Jovem Pan News", "m": "^jovem pan( news)?$", "c": "Notícias" },
    { "n": "BandSports", "m": "^band ?sports$", "c": "Esportes" }
  ]
}
